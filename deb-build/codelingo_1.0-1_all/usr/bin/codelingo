#!/usr/bin/env python3
import sys
import os
import threading
import http.server
import socketserver
import webbrowser
import socket

PORT = 28491
HTML_DIR = "/usr/share/codelingo"

def is_port_in_use(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        return s.connect_ex(('127.0.0.1', port)) == 0

class QuietHandler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=HTML_DIR, **kwargs)
    def log_message(self, format, *args):
        pass

def start_server():
    if not is_port_in_use(PORT):
        with socketserver.TCPServer(("127.0.0.1", PORT), QuietHandler) as httpd:
            httpd.serve_forever()

# Start background lightweight localhost server
t = threading.Thread(target=start_server, daemon=True)
t.start()

url = f"http://127.0.0.1:{PORT}/index.html"

# Try WebKit / PyGObject native window if available
launched_native = False
try:
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('WebKit2', '4.0')
    from gi.repository import Gtk, WebKit2

    window = Gtk.Window(title="CodeLingo - Oyun Kodlama")
    window.set_default_size(1024, 700)
    window.connect("destroy", Gtk.main_quit)

    view = WebKit2.WebView()
    view.load_uri(url)
    window.add(view)
    window.show_all()
    Gtk.main()
    launched_native = True
except Exception:
    pass

# If WebKit2 is not installed, open with default browser or xdg-open directly
if not launched_native:
    # Try chromium app mode or firefox or default browser
    if os.system(f"chromium --app={url} >/dev/null 2>&1 &") != 0:
        if os.system(f"google-chrome --app={url} >/dev/null 2>&1 &") != 0:
            webbrowser.open(url)
    # Keep server alive
    import time
    while True:
        try:
            time.sleep(1)
        except KeyboardInterrupt:
            break
